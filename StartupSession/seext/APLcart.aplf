 APLcart args
 :If 9=40 ⎕ATX'⎕SE.aplcartPopup'
     ⎕SE.aplcartPopup.Die ⍬
 :Else
     ⎕SE.mb.tools.aplcart.Checked←1
     :With '⎕SE.aplcartPopup'⎕WC'Form'('SysMenu' 0)('MaxButton' 0)('MinButton' 0)('Moveable' 0)('Size' ⋄ ##.Size×0.5 0.75)('Posn' ⋄ ##.Posn+##.Size×0.125)('AlphaBlend' 223)('BCol' ¯6)('Visible'0)
         :With '⎕SE.aplcartPopup.search'⎕WC'Edit'('Visible' 0)
             Posn←0 0
             Attach←'Top' 'Left' 'Top' 'Right'
             Size[2]←##.Size[2]
             Visible←1
             Update←{##.results.Values←⎕SE.Dyalog.Utils.APLcart Value}
             onChange←'Update'
             HandleKey←{
                 key←3⊃⍵ ⋄ code←⍵[5 6]
                 (code≡27 1)∨(27 0)''≡code Value:##.Die ⍬
                 key⊂⍛∊'UD'∘.,'CS':0⊣2 ⎕NQ ##.results'KeyPress'key
                 code≡36 2:##.results.Scroll'U'
                 code≡35 2:##.results.Scroll'D'
                 _←{⍵:Value⊢←'' ⋄ 0}27∊⊃code

                 'ER'≡key:##.results.Insert ⍬
                 code≡13 4:1 ##.results.Insert ⍬

                 'CP'≡key:##.results.Copy ⍬
                 code≡67 4:1 ##.results.Copy ⍬

                 Update&⍬
             }
             onKeyPress←'HandleKey'
         :EndWith
         :With '⎕SE.aplcartPopup.results'⎕WC'Grid'('Sizeable' 0)('HScroll' 0)('Posn' ⋄ 2↑⊃search.Size)('Size' ⋄ Size-2↑⊃search.Size)('Visible' 0)
             SetColSize ¯1 0
             SetRowSize ¯1 0
             Attach←'Top' 'Left' 'Bottom' 'Right'
             Coord←'Prop'
             Input←⎕NEW⊆'Label'('BCol' ¯14 ⋄ 'FCol' ¯15)
             CellWidths←25 75
             Values←⎕SE.Dyalog.Utils.APLcart''
             {}LockColumns 2
             Visible←1
             ResizeCells←{CellWidths⊢←25 75}
             onConfigure←'ResizeCells'
             onCellDblClick←'Insert'
             Scroll←{CurCell⊢←(2 1 ⋄ ¯1+⍴Values)⊃⍨'UD'⍳⍵ 0⊣2 ⎕NQ ⎕THIS'KeyPress'(⍵'C')}
             CurVal←{'\b[XYZMNIJABCD][svm]?\b'⎕R''⍣⍵⊢CurCell⊂⍛⊃Values}
             Insert←{⍺←4=⊃⌽6↑⍵ ⋄ ##.Die{⎕NQ ⎕SE'KeyPress'⍵}¨CurVal ⍺}
             Copy←{⍺←0 ⋄ (#.⎕NEW⊂'Clipboard').Text←CurVal ⍺}
             HandleKey←{
                 key←3⊃⍵ ⋄ code←⍵[5 6]
                 (code≡27 1)∨(27 0)''≡code ##.search.Value:##.Die ⍬

                 key≡'ER':0⊣Insert ⍬
                 code≡13 4:0⊣1 Insert ⍬

                 key≡'CP':Copy ⍬
                 code≡67 4:1 Copy ⍬

                 _←{⍵:Value⊢←'' ⋄ 0}27∊⊃code
                 ~code⊂⍛∊(9 1 ⋄ 9 0 ⋄ 27 0):1
                 0⊣⎕NQ ##.search'GotFocus' ⍝ (Shift+)TAB EP
             }
             onKeyPress←'HandleKey'
         :EndWith
         :With 'x'⎕WC'Button' '🞨'('Visible' 0)⍝('Cancel' 1)
             Size←2⍴⌊/Size
             Posn[1]←0.5×##.search.Size-⍥⊃Size
             Posn[2]←##.search.Size[2]-Size[2]+⊃Posn
             Visible←1
             HandleSelect←{
                 ''≡##.search.Value:##.Die ⍬
                 ##.search.Value←''
                 ⎕NQ ##.search'GotFocus'
             }
             onSelect←'HandleSelect'
         :EndWith
         Die←{⎕SE.mb.tools.aplcart.Checked←0 ⋄ ⎕EX⍕⎕THIS}
         Visible←1
     :EndWith
     ⎕NQ ⎕SE.aplcartPopup.search'GotFocus'
     ⎕DQ ⎕SE.aplcartPopup ⍝ need bc of Update& above
 :EndIf
