 {msg}←autoLink
⍝ If CLEAR WS, Link # to timestamped dir and set ⎕WSID
 ;path;ds
 :If ''≡⎕SYSTEM.Process.LaunchTarget
 :AndIf 'CLEAR WS'≡⎕WSID
 :AndIf (⊂⍕#)~⍤∊(⎕VGET⊂'⎕SE.Link.Links'(ns:0)).ns
     ds←⎕SYSTEM.OS.DirectorySeparator
     path←⎕SYSTEM.Directories.Temp,ds,⊃'YYYYMMDD.hhmmss'⎕DT'J'
     ⎕←msg←⎕SE.Link.Create # path
     ⎕WSID←path,ds
 :EndIf
